# Maple ingest gateway, compiled from source for linux/amd64 on the Fringe runners.
# Build context: apps/ingest/. Few jobs keep the compile inside Fringe's memory.
FROM rust:1.94-bookworm AS build
WORKDIR /app
ENV CARGO_BUILD_JOBS=2 CARGO_PROFILE_RELEASE_LTO=off CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
COPY . .
RUN cargo build --release --bin maple-ingest

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/target/release/maple-ingest /usr/local/bin/maple-ingest
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin maple-ingest
COPY docker/entrypoint.sh /usr/local/bin/maple-ingest-entrypoint
RUN chmod +x /usr/local/bin/maple-ingest-entrypoint
EXPOSE 3474
ENTRYPOINT ["/usr/local/bin/maple-ingest-entrypoint"]
